<% content_for :title, "Portfolio" %>

<section class="bg-secondary position-relative py-5">
  <div class="container position-relative zindex-2 py-5">
    <div class="row align-items-center gy-4">
      <div class="col-lg-8">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-3">
            <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
            <li class="breadcrumb-item active" aria-current="page">Portfolio</li>
          </ol>
        </nav>
        <h1 class="display-4 mb-3">Where Kidd Custom Apparel Shows Up</h1>
        <p class="fs-lg text-muted mb-0">Custom. Confident. Completely yours.</p>
        <p class="fs-lg text-muted mb-0 mt-2">From competition floors to center stage, these collaborations showcase how custom rhinestone apparel turns performances into unforgettable moments.</p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <%= link_to 'Start a project', new_inquiry_path, class: 'btn btn-lg btn-primary me-2 mb-3 mb-lg-0' %>
        <%= link_to 'Download lookbook', '#', class: 'btn btn-lg btn-outline-primary' %>
      </div>
    </div>
  </div>
</section>

<section class="container py-5 py-lg-6">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-3 mb-lg-0">Browse by focus</h2>
    <ul class="nav nav-pills nav-fill flex-grow-1 flex-lg-grow-0 gap-2">
      <% ['All work', 'Teams', 'Creators', 'Events', 'Pop-ups'].each_with_index do |filter, index| %>
        <li class="nav-item flex-grow-1 flex-lg-grow-0">
          <button class="nav-link <%= 'active' if index.zero? %>" type="button"><%= filter %></button>
        </li>
      <% end %>
    </ul>
  </div>

  <% projects = [
    { image: 'theme/kiddcustomwebsitephotos/IMG_3397.jpeg', category: 'Teams', title: 'NSB Cheer Uniform', description: 'Custom rhinestone lettering on performance cheer tops for a competitive squad.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_2895.jpeg', category: 'Teams', title: 'Corner Canyon Rhinestone Set', description: 'Sparkle-ringed logo on navy performance sweatshirts for the Corner Canyon team.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_7450.jpeg', category: 'Leotards', title: 'Red Performance Leotard', description: 'Rhinestone-embellished competition leotard built for movement and sparkle.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_7470.jpg', category: 'Leotards', title: 'Intricate Web Detail', description: 'Hand-placed rhinestone web pattern on a red competition leotard.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_7485.jpg', category: 'Sports Bras', title: 'BHHS Rhinestone Sports Bra', description: 'Custom rhinestone lettering on pink performance sports bra for a high school team.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_7574.jpeg', category: 'Branding', title: 'KIDD Branded Crop', description: 'Bold rhinestone branding on a black crop top — signature studio identity.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_7789.jpeg', category: 'Creators', title: 'Honeybee Crown Tee', description: 'Elegant rhinestone crown and wordmark for a creator brand launch.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_6053.jpg', category: 'Bags', title: 'Harper Custom Dance Bag', description: 'Personalized glitter dance bag with rhinestone name embellishment.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_6884.jpeg', category: 'Bags', title: 'DDA Rhinestone Dance Bag', description: 'Purple team dance bag with custom rhinestone lettering for DDA.', link: '#'},
    { image: 'theme/kiddcustomwebsitephotos/IMG_3564.jpeg', category: 'Branding', title: 'DA Crown Rhinestone', description: 'Crown and initials rhinestone design on black performance fabric.', link: '#'}
  ] %>

  <div class="row g-4">
    <% projects.each do |project| %>
      <div class="col-md-6">
        <article class="card border-0 shadow-sm h-100">
          <%= image_tag project[:image], class: 'card-img-top', alt: project[:title] %>
          <div class="card-body p-4">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-3"><%= project[:category] %></span>
            <h3 class="h4 mb-2"><a class="stretched-link text-decoration-none" href="<%= project[:link] %>"><%= project[:title] %></a></h3>
            <p class="text-muted mb-0"><%= project[:description] %></p>
          </div>
        </article>
      </div>
    <% end %>
  </div>
</section>

<section class="bg-dark text-light py-5">
  <div class="container py-lg-4 py-xl-5">
    <div class="row align-items-center gy-4">
      <div class="col-lg-7">
        <h2 class="display-5 mb-3">Now Booking Custom Projects</h2>
        <p class="fs-lg mb-0 opacity-75">Limited availability to keep every piece one of one.</p>
      </div>
      <div class="col-lg-5 text-lg-end">
        <%= link_to 'Book a discovery call', new_inquiry_path, class: 'btn btn-lg btn-outline-light' %>
      </div>
      <div class="col-12 d-none d-dark-mode-block border-top border-secondary mt-4 pt-4">
        <div class="row align-items-center gy-4">
          <div class="col-lg-8">
            <h3 class="h4 mb-2">Need custom apparel support?</h3>
            <p class="fs-lg mb-0 opacity-75">From the first idea to final shipment, we take care of every detail—so your team can focus on performance while we handle the sparkle.</p>
          </div>
          <div class="col-lg-4 text-lg-end">
            <%= link_to 'Start a project', new_inquiry_path, class: 'btn btn-outline-light' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
