<% content_for :title, "About" %>

<section class="bg-dark position-relative py-5">
  <div class="d-none d-dark-mode-block position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(255,255,255, .02);"></div>
  <div class="container dark-mode position-relative zindex-2 py-5 mb-4 mb-sm-5">
    <div class="row pb-5 mb-2 mb-sm-0 mb-lg-3">
      <div class="col-lg-10 col-xl-9">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb pt-lg-3 pb-lg-4 pb-2">
            <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
            <li class="breadcrumb-item active" aria-current="page">About us</li>
          </ol>
        </nav>
        <h1 class="display-2 pb-2 pb-sm-3">Built for athletes to shine</h1>
        <ul class="list-unstyled d-flex flex-wrap mb-0 text-light opacity-75">
          <% [
            'Design-to-delivery support for athletes and teams',
            'Material sourcing, rhinestone embellishment, and QC under one roof',
            'Collaborative partners who treat your team like our own'
          ].each do |value| %>
            <li class="d-flex py-1 me-4">
              <i class="ai-check-alt text-primary lead me-2"></i>
              <span><%= value %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="container position-relative zindex-3" style="margin-top: -135px;">
  <div class="rounded-5 overflow-hidden">
    <div class="jarallax ratio ratio-16x9" data-jarallax data-speed="0.6">
      <div class="jarallax-img" style="background-image: url(<%= asset_path('theme/about/agency/parallax-image.jpg') %>);"></div>
    </div>
  </div>
  <div class="row pt-5 mt-n2 mt-sm-0 mt-md-2 mt-lg-4 mt-xl-5">
    <div class="col-md-6 col-lg-5">
      <div class="fs-sm text-uppercase mb-3">What We Do</div>
      <h2 class="display-6">We create performance looks that help athletes shine.</h2>
    </div>
    <div class="col-md-6 col-xl-5 offset-lg-1 offset-xl-2 pt-1 pt-sm-2 pt-md-5">
      <p class="fs-xl">From initial concepts to final quality control, we guide your team through every decision—design direction, blank sourcing, placement, rhinestone embellishment, and fulfillment—so your focus stays on training and performance.</p>
      <p class="fs-xl">Because we produce in-house, we're able to prototype quickly, collaborate closely with coaches and creative leads, and deliver apparel that holds up through rehearsals, travel, and competition.</p>
      <p class="fs-xl mb-0">And when it's time to hit the floor, mat, or stage, we're ready—supporting reorders and your next big idea.</p>
    </div>
  </div>
</section>

<section class="pt-5 mt-md-2 mt-xl-4 mt-xxl-5">
  <div class="container pt-2 pt-sm-4 pt-lg-5 mt-xxl-2">
    <div class="fs-sm text-uppercase mb-3">Our Mission</div>
    <h2 class="display-6 pb-2 mb-3">Our mission is to help athletes shine.</h2>
    <p class="fs-xl pb-2 mb-lg-4">We partner with teams and organizations to create custom, rhinestone-embellished performance wear that blends comfort, quality, and unforgettable sparkle. Through thoughtful design, expert craftsmanship, and dependable delivery, we bring your vision to life—on time and ready to perform.</p>
    <h3 class="h4 pb-3 mb-lg-4">How We Support Your Team</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
      <% [
        {icon: 'ai-trending-up', title: 'Professional Approach', text: 'We map out the right blanks, embellishment techniques, and fulfillment plan to meet your performance goals and deadlines.'},
        {icon: 'ai-layers', title: 'Creative Development', text: "Our designers refine artwork, placements, and sizing to ensure every detail reflects your team's identity and movement needs."},
        {icon: 'ai-lightning', title: 'Production & Quality', text: 'All embellishment, quality control, and pack-out are handled in-house to maintain consistency, durability, and flawless presentation.'},
        {icon: 'ai-target', title: 'Ongoing Support', text: 'From reorders to last-minute needs, we stay with you every step of the way—supporting your athletes from first fitting to final performance.'}
      ].each do |item| %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3">
                <i class="<%= item[:icon] %>"></i>
              </div>
              <h3 class="h5"><%= item[:title] %></h3>
              <p class="mb-0 text-muted"><%= item[:text] %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="py-5 py-lg-6">
  <div class="container py-2 py-sm-4 py-lg-5">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <%= image_tag 'theme/about/agency/steps-image.jpg', class: 'rounded-4 w-100 shadow-sm', alt: 'Creative workshop' %>
      </div>
      <div class="col-lg-6 col-xl-5 offset-xl-1">
        <div class="fs-sm text-uppercase mb-3">Our Process</div>
        <h2 class="display-6 mb-4">A clear path from vision to performance</h2>
        <ul class="list-unstyled mb-0">
          <% [
            {step: '01', title: 'Discover', text: 'We start with a kickoff call to understand your goals, timeline, and aesthetic. From mood boards to samples, we align on the vibe so every detail supports your vision.'},
            {step: '02', title: 'Design', text: 'Artwork, placements, and sizing grids are finalized while we source high-quality blanks built for comfort and movement. Every element is thoughtfully planned for performance and sparkle.'},
            {step: '03', title: 'Deliver', text: "From rhinestone application to quality control and fulfillment, production is handled in-house. Your order arrives on time, organized, and show-ready—so your athletes can shine."}
          ].each do |stage| %>
            <li class="d-flex mb-4">
              <div class="me-3 flex-shrink-0">
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fs-base px-3 py-2"><%= stage[:step] %></span>
              </div>
              <div>
                <h3 class="h5 mb-1"><%= stage[:title] %></h3>
                <p class="text-muted mb-0"><%= stage[:text] %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="bg-secondary py-5">
  <div class="container py-lg-4 py-xl-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% [
        {value: '150+', label: 'Custom drops fulfilled each year'},
        {value: '2-6 weeks', label: 'Typical production timeline'},
        {value: '97%', label: 'Clients returning for the next launch'}
      ].each do |stat| %>
        <div class="col">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-5">
              <h3 class="display-4 text-primary mb-2"><%= stat[:value] %></h3>
              <p class="mb-0 text-muted"><%= stat[:label] %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="py-5 py-lg-6">
  <div class="container py-4 py-lg-5">
    <div class="row align-items-center gy-4">
      <div class="col-lg-7">
        <h2 class="display-5 mb-3">Ready to collaborate?</h2>
        <p class="fs-lg text-muted mb-0">Let’s build your next standout look. Kidd Custom Apparel supports your team from concept to delivery—so you can focus on performance while we handle the sparkle.</p>
      </div>
      <div class="col-lg-5 text-lg-end">
        <%= link_to 'Start a project', new_inquiry_path, class: 'btn btn-lg btn-primary me-3 mb-3 mb-lg-0' %>
        <%= link_to 'View our work', gallery_path, class: 'btn btn-lg btn-outline-primary' %>
      </div>
    </div>
  </div>
</section>
